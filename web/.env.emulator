# `npm run dev:emulator`: talk to the local Firebase emulators instead of the real
# project. Start them from the repository root with
# node "C:/Program Files/nodejs/node_modules/npm/bin/npx-cli.js" --yes firebase-tools@13.29.1 emulators:start --only auth,firestore --project demo-electropos
# then fill them with `npm --prefix web run seed:emulator`.
VITE_USE_EMULATOR=true
